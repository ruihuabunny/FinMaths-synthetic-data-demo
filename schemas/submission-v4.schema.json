{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission-v4.schema.json",
  "title": "Executable calendar-enabled F2A v4 solver submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "snapshot_id",
    "snapshot_revision",
    "variant_id",
    "output_contract_id",
    "trajectory"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_revision": {"type": "integer", "minimum": 1},
    "variant_id": {"const": "bsm-arbitrage-finding-f2a-v4"},
    "output_contract_id": {"const": "arbitrage-opportunity-type-trajectory-v5"},
    "trajectory": {"$ref": "trajectory.schema.json"}
  }
}
