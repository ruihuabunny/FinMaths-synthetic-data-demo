{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mutation-v2.schema.json",
  "title": "V2 mutated task and deterministic coordinate lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "lineage"],
  "properties": {
    "task": {"$ref": "task-v2.schema.json"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_task_id",
        "child_task_id",
        "operator",
        "before",
        "after",
        "seed",
        "engine_id",
        "compatibility_rule_id"
      ],
      "properties": {
        "parent_task_id": {"type": "string", "minLength": 1},
        "child_task_id": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "before": {"$ref": "difficulty-v2.schema.json"},
        "after": {"$ref": "difficulty-v2.schema.json"},
        "seed": {"type": "integer", "minimum": 0},
        "engine_id": {"type": "string", "minLength": 1},
        "compatibility_rule_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
