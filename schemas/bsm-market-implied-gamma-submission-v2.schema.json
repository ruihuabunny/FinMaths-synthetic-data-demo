{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bsm-market-implied-gamma-submission-v2.schema.json",
  "x-schema-version": "bsm-market-implied-gamma-submission-v2.0.0",
  "title": "Canonical market-implied BSM Gamma submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "submission_schema_version",
    "method_id",
    "status",
    "rows"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^bsm-market-gamma-v2-[0-9a-f]{24}$"
    },
    "submission_schema_version": {
      "const": "bsm-market-implied-gamma-submission-v2.0.0"
    },
    "method_id": {
      "const": "bsm-mid-iv-bisection80-analytic-gamma-v1"
    },
    "status": {
      "const": "completed"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resultRow"
      }
    }
  },
  "$defs": {
    "nonnegativeDecimal8": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{8}$"
    },
    "resultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "unit_gamma"
      ],
      "properties": {
        "row_id": {
          "type": "string",
          "pattern": "^row_[0-9]{6}$"
        },
        "unit_gamma": {
          "$ref": "#/$defs/nonnegativeDecimal8"
        }
      }
    }
  }
}
