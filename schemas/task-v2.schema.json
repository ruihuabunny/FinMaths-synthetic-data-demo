{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-v2.schema.json",
  "title": "Registered immutable seven-dimensional derivatives task",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id",
    "task_family_id",
    "coordinates",
    "snapshot_id",
    "snapshot_revision",
    "registry_id",
    "compatibility_rule_id",
    "method_id",
    "variant_id",
    "output_contract_id"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "task_family_id": {"type": "string", "minLength": 1},
    "coordinates": {"$ref": "difficulty-v2.schema.json"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "snapshot_revision": {"type": "integer", "minimum": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "compatibility_rule_id": {"type": "string", "minLength": 1},
    "method_id": {"type": "string", "minLength": 1},
    "variant_id": {"type": "string", "minLength": 1},
    "output_contract_id": {"type": "string", "minLength": 1}
  }
}
