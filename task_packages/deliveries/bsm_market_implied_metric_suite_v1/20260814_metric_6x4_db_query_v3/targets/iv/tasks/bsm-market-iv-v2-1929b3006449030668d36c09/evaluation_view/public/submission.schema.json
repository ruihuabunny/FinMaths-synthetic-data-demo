{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bsm-market-implied-iv-submission-v2.schema.json",
  "x-schema-version": "bsm-market-implied-iv-submission-v2.0.0",
  "title": "Canonical market-implied BSM volatility submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "submission_schema_version",
    "method_id",
    "status",
    "rows"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^bsm-market-iv-v2-[0-9a-f]{24}$"
    },
    "submission_schema_version": {
      "const": "bsm-market-implied-iv-submission-v2.0.0"
    },
    "method_id": {
      "const": "bsm-mid-iv-bisection80-v1"
    },
    "status": {
      "const": "completed"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resultRow"
      }
    }
  },
  "$defs": {
    "positiveDecimal8": {
      "type": "string",
      "pattern": "^(?!(?:0\\.0{8})$)(?:0|[1-9][0-9]*)\\.[0-9]{8}$"
    },
    "resultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "iv_status",
        "market_implied_volatility"
      ],
      "properties": {
        "row_id": {
          "type": "string",
          "pattern": "^row_[0-9]{6}$"
        },
        "iv_status": {
          "const": "CONVERGED_FIXED_ITERATIONS"
        },
        "market_implied_volatility": {
          "$ref": "#/$defs/positiveDecimal8"
        }
      }
    }
  }
}
